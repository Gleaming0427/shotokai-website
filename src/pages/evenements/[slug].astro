---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import { getExcerpt } from '../../lib/excerpt';

export async function getStaticPaths() {
  const events = await getCollection('evenements');
  return events.map(event => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { title, tag, date, image } = event.data;
const description = getExcerpt(event.body, 155);
const pageUrl = new URL(`/evenements/${event.id}/`, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}, Événements, Lacroix-Falgarde</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow" />

    <meta property="og:title" content={`${title}, Événements`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="fr_FR" />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
  </head>

  <body class="page-inner">
    <a href="#main" class="skip-link">Aller au contenu</a>
    <Header />
    <main id="main">
      <article class="section" style="padding-top: 6rem;">
        <div class="container">
          <p style="text-align:center;margin-bottom:1rem;">
            <a href="/evenements/" style="color:var(--color-text-soft);font-size:.9rem;">&larr; Retour aux événements</a>
          </p>
          <h1 class="section-title" style="text-transform:none;letter-spacing:.04em;">{title}</h1>
          <time class="article-date" datetime={date.toISOString().split('T')[0]}>
            {date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
          {tag && (
            <p style="text-align:center;margin-top:.6rem;">
              <span class="event-tag">{tag}</span>
            </p>
          )}
          {image && <img src={image} alt={title} class="article-hero" />}
          <div class="prose article-body">
            <p>{event.body}</p>
          </div>
        </div>
      </article>
    </main>
    <Footer />
    <Fragment set:html={`<script>(function(){var needsIdentity=(window.location.hash&&window.location.hash.includes("invite_token"))||localStorage.getItem("gotrue.user");if(!needsIdentity)return;var s=document.createElement("script");s.src="https://identity.netlify.com/v1/netlify-identity-widget.js";s.onload=function(){window.netlifyIdentity&&window.netlifyIdentity.on("init",function(u){u||window.netlifyIdentity.on("login",function(){document.location.href="/admin/";})}),window.netlifyIdentity&&window.netlifyIdentity.init();};document.head.appendChild(s);})();<\/script>`} />
  </body>
</html>
