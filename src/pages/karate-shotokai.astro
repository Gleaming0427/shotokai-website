---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { getExcerpt } from '../lib/excerpt';

const articles = await getCollection('karate-shotokai');
articles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`/favicon.svg`} />
    <link rel="icon" type="image/png" href={`/favicon.png`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />

    <title>Blog Karaté Shotokaï — Dojo de Lacroix-Falgarde (31)</title>
    <meta name="description" content="Le blog du Karaté Shotokaï du dojo de Lacroix-Falgarde : histoire, principes et pratique de cet art martial japonais traditionnel, près de Toulouse." />
    <link rel="canonical" href={new URL('/karate-shotokai/', Astro.site)} />
    <meta name="robots" content="index, follow" />

    <meta property="og:title" content="Blog Karaté Shotokaï — Dojo de Lacroix-Falgarde (31)" />
    <meta property="og:description" content="Histoire, principes et pratique du Karaté Shotokaï, art martial japonais traditionnel, au dojo de Lacroix-Falgarde." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL('/karate-shotokai/', Astro.site)} />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Blog Karaté Shotokaï — Lacroix-Falgarde" />
  </head>

  <body class="page-inner">
    <a href="#main" class="skip-link">Aller au contenu</a>
    <Header />
    <main id="main">
      <section class="section" style="padding-top: 6rem;">
        <div class="container">
          <h1 class="section-title" style="text-transform: none; letter-spacing: 0.04em;">Karaté Shotokaï</h1>
          <p class="prose" style="text-align: center; margin-top: -1.5rem; margin-bottom: 3rem; color: var(--color-text-soft);">
            Histoire, principes et pratique de cet art martial japonais traditionnel, au dojo de Lacroix-Falgarde.
          </p>

          {articles.length === 0 ? (
            <p style="text-align: center; color: var(--color-text-soft);">À venir prochainement.</p>
          ) : (
            <div class="articles-grid">
              {articles.map(article => (
                <a href={`/karate-shotokai/${article.id}/`} class="article-card">
                  {article.data.image && (
                    <img src={article.data.image} alt={article.data.title} loading="lazy" />
                  )}
                  <div class="article-card-body">
                    <time datetime={article.data.date.toISOString().split('T')[0]}>
                      {article.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
                    </time>
                    <h2>{article.data.title}</h2>
                    <p>{getExcerpt(article.body, 150)}</p>
                    <span class="article-read-more">Lire la suite &rarr;</span>
                  </div>
                </a>
              ))}
            </div>
          )}
        </div>
      </section>
    </main>
    <Footer />
    <Fragment set:html={`<script>(function(){var needsIdentity=(window.location.hash&&window.location.hash.includes("invite_token"))||localStorage.getItem("gotrue.user");if(!needsIdentity)return;var s=document.createElement("script");s.src="https://identity.netlify.com/v1/netlify-identity-widget.js";s.onload=function(){window.netlifyIdentity&&window.netlifyIdentity.on("init",function(u){u||window.netlifyIdentity.on("login",function(){document.location.href="/admin/";})}),window.netlifyIdentity&&window.netlifyIdentity.init();};document.head.appendChild(s);})();<\/script>`} />
  </body>
</html>
