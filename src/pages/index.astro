---
// index.astro : Single page du site Karaté Shotokaï Lacroix-Falgarde
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import APropos from '../components/APropos.astro';
import Karate from '../components/Karate.astro';
import Iaijutsu from '../components/Iaijutsu.astro';
import Horaires from '../components/Horaires.astro';
import Evenements from '../components/Evenements.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getCollection } from 'astro:content';

const contactEntries = await getCollection('contact');
const contact = contactEntries[0]?.data;

const ldJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  name: 'Karaté Shotokaï & Iaijutsu, Lacroix-Falgarde',
  description: "Club d'arts martiaux à Lacroix-Falgarde, près de Toulouse : Karaté-do Shotokaï et Iaijutsu. Pratique traditionnelle sans compétition, accessible à tous.",
  url: 'https://karate-lacroix-falgarde.fr/',
  image: 'https://karate-lacroix-falgarde.fr/images/hero-bg.webp',
  logo: 'https://karate-lacroix-falgarde.fr/images/logo.webp',
  alternateName: 'Karaté Shotokaï & Iaijutsu Lacroix-Falgarde',
  knowsAbout: ['Karaté-do Shotokaï', 'Iaijutsu', 'Arts martiaux japonais'],
  hasMap: 'https://www.google.com/maps?q=43.5042,1.4165',
  telephone: contact?.telephone || '+33682665370',
  priceRange: '30€-60€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact?.adresse_rue || 'Avenue de Falgarde',
    postalCode: '31120',
    addressLocality: contact?.adresse_ville || '31120 Lacroix-Falgarde',
    addressCountry: 'FR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: '43.5042',
    longitude: '1.4165',
  },
  areaServed: {
    '@type': 'GeoCircle',
    geoMidpoint: {
      '@type': 'GeoCoordinates',
      latitude: '43.5042',
      longitude: '1.4165',
    },
    geoRadius: '20000',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Wednesday', opens: '18:30', closes: '21:15' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '14:00', closes: '16:30' },
  ],
  memberOf: [
    { '@type': 'Organization', name: 'Karaté-do Shotokaï Europe (KDSE)', url: 'https://shotokaieurope.org' },
    { '@type': 'Organization', name: 'FEKAMT', url: 'https://fekamt.com' },
  ],
});
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`/favicon.svg`} />
    <link rel="icon" type="image/png" href={`/favicon.png`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload image critique (LCP) -->
    <link rel="preload" as="image" href={`/images/hero-bg.webp`} fetchpriority="high" />

    <!-- SEO -->
    <title>Arts Martiaux Karaté Shotokaï & Iaijutsu, Lacroix-Falgarde (31)</title>

    <!-- Structured data -->
    <script type="application/ld+json" set:html={ldJson}></script>
    <meta name="description" content="Club d'arts martiaux à Lacroix-Falgarde (31) : Karaté-do Shotokaï et Iaijutsu près de Toulouse. Pratique traditionnelle sans compétition, ouverte à tous." />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content="Arts Martiaux Karaté Shotokaï & Iaijutsu, Lacroix-Falgarde (31)" />
    <meta property="og:description" content="Club d'arts martiaux à Lacroix-Falgarde (31) : Karaté-do Shotokaï et Iaijutsu près de Toulouse. Pratique traditionnelle sans compétition, ouverte à tous." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL('/', Astro.site)} />
    <meta property="og:image" content={new URL('/images/hero-bg.webp', Astro.site)} />
    <meta property="og:image:width" content="1152" />
    <meta property="og:image:height" content="768" />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Arts Martiaux Karaté Shotokaï & Iaijutsu, Lacroix-Falgarde" />
    <meta name="twitter:description" content="Club d'arts martiaux à Lacroix-Falgarde (31) : Karaté-do Shotokaï et Iaijutsu. Pratique traditionnelle, pas de compétition." />
    <meta name="twitter:image" content={new URL('/images/hero-bg.webp', Astro.site)} />
  </head>

  <body>
    <a href="#main" class="skip-link">Aller au contenu</a>
    <Header />
    <main id="main">
      <Hero />
      <APropos />
      <Karate />
      <Iaijutsu />
      <Horaires />
      <Evenements />
      <FAQ />
      <Contact />
    </main>
    <Footer />
    <Fragment set:html={`<script>(function(){var needsIdentity=(window.location.hash&&window.location.hash.includes("invite_token"))||localStorage.getItem("gotrue.user");if(!needsIdentity)return;var s=document.createElement("script");s.src="https://identity.netlify.com/v1/netlify-identity-widget.js";s.onload=function(){if(window.netlifyIdentity){window.netlifyIdentity.on("init",function(u){if(!u){window.netlifyIdentity.on("login",function(){document.location.href="/admin/";});}});window.netlifyIdentity.init();window.location.hash&&window.location.hash.includes("invite_token")&&window.netlifyIdentity.open("signup");}};document.head.appendChild(s);})();<\/script>`} />
    <script>
      // Ancres : le défilement fluide natif suffit (les images réservent leur espace).
      // Une seule correction après chargement complet, en cas de léger décalage.
      if (window.location.hash) {
        const id = window.location.hash.substring(1);
        window.addEventListener('load', () => {
          document.getElementById(id)?.scrollIntoView({ behavior: 'instant', block: 'start' });
        });
      }
    </script>
  </body>
</html>
