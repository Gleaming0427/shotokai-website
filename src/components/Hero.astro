---
import { getCollection } from 'astro:content';

const repriseEntries = await getCollection('reprise');
const reprise = repriseEntries[0];
const repriseLabel = reprise?.data.label || 'Reprise des cours';

const repriseDate = reprise?.data.date;
const MOIS_COURTS = ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'];
const jour = repriseDate ? String(repriseDate.getDate()).padStart(2, '0') : '';
const moisCourt = repriseDate ? MOIS_COURTS[repriseDate.getMonth()] : '';
const annee = repriseDate ? String(repriseDate.getFullYear()) : '';
const dateLigne = repriseDate
  ? repriseDate.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' }).replace(/^./, (c) => c.toUpperCase())
  : '';
const heure = reprise?.data.heure || '';
---

<section class="hero" id="hero">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="hero-logo" role="img" aria-label="Karaté Shotokaï &amp; Iaijutsu Lacroix Falgarde"></div>
    <h1><a href="/#horaires">Karaté Shotokaï &amp; Iaijutsu</a></h1>
    <p class="hero-tagline">Accessible à toutes et à tous, aux petits comme aux grands&nbsp;!</p>
    <a href="/#horaires" class="btn">Horaires et tarifs</a>

    {reprise && (
      <a
        href="/#evenements"
        class="hero-event"
        id="hero-event"
        data-image=""
        data-tag={repriseLabel}
        data-title={reprise.data.title}
        data-desc={reprise.body || ''}
      >
        <span class="hero-event-date" aria-hidden="true">
          <span class="hero-event-date-day">{jour}</span>
          <span class="hero-event-date-month">{moisCourt} {annee}</span>
        </span>
        <span class="hero-event-body">
          <span class="hero-event-label">{repriseLabel}</span>
          <span class="hero-event-title">{heure ? `${dateLigne} • ${heure}` : dateLigne}</span>
        </span>
        <svg class="hero-event-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 6l6 6-6 6"></path>
        </svg>
      </a>
    )}
  </div>
</section>

<script>
  const heroEvent = document.getElementById('hero-event');
  const modal = document.getElementById('event-modal');
  if (heroEvent && modal) {
    const emImg = document.getElementById('em-img') as HTMLImageElement;
    const emTag = document.getElementById('em-tag')!;
    const emTitle = document.getElementById('em-title')!;
    const emDesc = document.getElementById('em-desc')!;

    heroEvent.addEventListener('click', (e) => {
      e.preventDefault();
      const img = heroEvent.getAttribute('data-image');
      if (img) { emImg.src = img; emImg.style.display = 'block'; }
      else { emImg.style.display = 'none'; }
      emTag.textContent = heroEvent.getAttribute('data-tag') || '';
      emTitle.textContent = heroEvent.getAttribute('data-title') || '';
      emDesc.textContent = heroEvent.getAttribute('data-desc') || '';
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    });
  }
</script>
